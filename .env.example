# Copy to .env (gitignored) and fill in. Everything in VERDICT runs WITHOUT a key:
# with no key every agent resolves to no-LLM and rule 11 runs the deterministic
# autopilot, which still produces a valid, tiered verdict.
OPENAI_API_KEY=
# 1 = never call out; replay cached transcripts/narration instead (demo mode).
OFFLINE=0
# Hard ceiling on LLM spend per process, enforced in code (rule 10), checked BEFORE
# each request. Tripping it degrades the run to the autopilot, never a crash.
# Unset/empty = no ceiling. See backend/agents/usage.py.
VERDICT_SPEND_CAP_USD=0.50
