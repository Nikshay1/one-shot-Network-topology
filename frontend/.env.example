# Base URL of the VERDICT API (backend/main.py, `make run`).
# No trailing slash. The SSE `stream` field returned by POST /case/{id}/run is
# root-relative ("/stream/{run_id}"), so it is appended to this base verbatim.
VITE_API_BASE=http://localhost:8000

# 1 = MOCK MODE: no network at all. client.ts serves fixture JSON copied from
# /fixtures and stream.ts replays src/mocks/sse_sequence.jsonl. The whole UI is
# developable and demoable with the backend down.
VITE_MOCK=0
